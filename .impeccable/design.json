  "narrative": {
    "northStar": "The Annual Report",
    "overview": "The audit is set as a Swiss International Style annual report. The measured numbers are the typography: two figures near 130px carry the first screen, and everything else is ruled, numbered and set in one neo-grotesk on a 12-column grid. White paper, black ink, one grey, one signal red. Nothing is boxed, tinted or lifted; 2px black rules divide the page, and sections, figures and notes carry numbers the way a printed report does.\n\nDensity is that of a report, not a dashboard: generous vertical spacing between numbered sections, tight ruled rows within them. The world refuses the SaaS KPI-card page (tinted stat tiles, rounded cards, shadows) and the cream editorial data story. State is shown by a mark (a flag, a stamp, a tick, a strike, a dashed border) and never by a hue alone.\n\nThe dark theme is the same report inverted: black paper, white ink, a brighter red. It follows the OS until the reader picks one with the toggle.",
    "keyCharacteristics": [
      "One family (Hanken Grotesk), extrabold for anything that leads, tabular lining numerals everywhere.",
      "2px ink rules as the only dividers of consequence; 1px grey rules between rows.",
      "Square corners on every surface and control.",
      "Flat: no shadows, no tinted card fills.",
      "Numbered sections, figures and notes; the number hangs in column 1.",
      "Red is a signal, not a palette colour."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "section": "colors",
        "body": "Red marks what was stopped and the report's own numbering; a legitimate purchase declined is a cost and is stamped in ink-2, never red."
      },
      {
        "name": "The Mark Not Hue Rule",
        "section": "colors",
        "body": "Every state reads without colour: verdicts are an icon plus a label in ink, planted cases are a solid-bordered tag, control cases a dashed one, the current setting is a flag."
      },
      {
        "name": "The Numbers Are The Type Rule",
        "section": "typography",
        "body": "The largest thing on a page is a measured number, never a word or an illustration."
      },
      {
        "name": "The Ruled Not Lifted Rule",
        "section": "elevation",
        "body": "If something needs separating, rule it; never shadow it, tint it or round it."
      }
    ],
    "dos": [
      "Do divide with 2px ink rules and number sections, figures (Figure N.) and notes (Note N.).",
      "Do let a measured number be the largest element on the page, set in figure style with a ruled caption.",
      "Do keep every corner square and every surface flat and untinted.",
      "Do show state with a mark (flag, stamp, icon + label, solid vs dashed border) that survives greyscale.",
      "Do keep numerals tabular and lining, and money columns right-aligned."
    ],
    "donts": [
      "Don't use signal red for anything except misuse stopped and the report's own marks (numbers, logo square, current setting, focus).",
      "Don't stamp or colour a legitimate purchase declined in red; it is a cost, set in ink-2.",
      "Don't use shadows, rounded corners, pills or tinted card fills.",
      "Don't introduce a second typeface or a monospace for display.",
      "Don't set KPI tiles or stat cards; figures stand on rules in the grid."
    ]
  }
